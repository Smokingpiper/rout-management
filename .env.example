# Vercel の Settings > Environment Variables に登録する（Production + Preview 両方）
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# モックアップのアノテーション機能（共有コメント）用。Neon Postgresの接続文字列
# 未設定の間はアノテーション機能が自動的に無効化される（他の機能には影響しない）
DATABASE_URL=

# 地図表示（MapTiler、ブラウザに公開されるキー）。https://www.maptiler.com/ で取得
# 未設定の間は簡易SVG表示に自動フォールバックする
NEXT_PUBLIC_MAPTILER_KEY=
